# Copy this file to .env.yaml and fill in real values.
# .env.yaml is gitignored — never commit it.

# Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN: "PASTE_BOT_TOKEN_HERE"

# Discord Developer Portal > General Information > Public Key
DISCORD_PUBLIC_KEY: "PASTE_PUBLIC_KEY_HERE"

# The Discord server (guild) ID the bot operates in
DISCORD_GUILD_ID: "PASTE_GUILD_ID_HERE"

# The admin channel ID where new-event-request messages get posted
DISCORD_ADMIN_CHANNEL_ID: "PASTE_ADMIN_CHANNEL_ID_HERE"

# The public channel ID where new-event announcements get posted
DISCORD_ANNOUNCEMENT_CHANNEL_ID: "PASTE_ANNOUNCEMENT_CHANNEL_ID_HERE"

# Shared secret between the Apps Script trigger and the formSubmit function.
# Must match SHARED_SECRET in appsscript/onFormSubmit.js.
FORM_SHARED_SECRET: "PICK_A_RANDOM_SECRET_STRING"

# Google Calendar that is the source of truth for events — share it with
# this project's default compute service account (Make changes to events),
# then paste its Calendar ID here (Calendar Settings > Integrate calendar).
GOOGLE_CALENDAR_ID: "PASTE_CALENDAR_ID_HERE"

# Gmail account used to send the bi-weekly digest email (via SMTP with an
# app password — requires 2FA enabled on the account first: Google Account
# > Security > 2-Step Verification > App passwords).
GMAIL_SENDER_EMAIL: "PASTE_GMAIL_ADDRESS_HERE"
GMAIL_APP_PASSWORD: "PASTE_APP_PASSWORD_HERE"
